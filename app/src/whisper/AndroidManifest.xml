<?xml version="1.0" encoding="utf-8"?>
<!-- whisper build only: voice input sends audio to the configured Whisper server -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <!-- opened from the "Whisper" entry at the top of the keyboard settings -->
        <activity android:name="helium314.keyboard.latin.whisper.WhisperSettingsActivity"
            android:label="Whisper"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
    </application>
</manifest>
