<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep dictated text (history) and unsent recordings out of cloud backup and device transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="whisper.xml" />
        <exclude domain="device_sharedpref" path="whisper.xml" />
        <exclude domain="file" path="whisper_pending/" />
        <exclude domain="device_file" path="whisper_pending/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="whisper.xml" />
        <exclude domain="device_sharedpref" path="whisper.xml" />
        <exclude domain="file" path="whisper_pending/" />
        <exclude domain="device_file" path="whisper_pending/" />
    </device-transfer>
</data-extraction-rules>
